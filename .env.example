# ============================================================
# Sensor Tower Pipeline - Environment Variables Template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---- Steam Web API ----
# Get key: https://steamcommunity.com/dev/apikey (login Steam → key ngay)
STEAM_API_KEY=your_steam_api_key_here

# ---- Twitch Developer (cho IGDB API) ----
# Get credentials: https://dev.twitch.tv/console → create app
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# ---- iTunes Search API ----
# KHÔNG cần key, free public API (~20 req/min)
# Biến dưới để bật/tắt crawler
ITUNES_ENABLED=true

# ---- Database ----
# Đường dẫn SQLite DB (relative to project root)
SQLITE_PATH=./data/sensortower.db

# ---- API server (auth cho Power BI / cloudflare tunnel) ----
# Random string — generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Power BI gửi header: X-API-Key: <key>
API_KEY=your_api_key_here

# ---- Pipeline behavior ----
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Số game/app tối đa mỗi nguồn (MVP = 100)
MAX_GAMES_PER_SOURCE=100
# Bật/tắt từng crawler (true/false)
STEAM_ENABLED=true
IGDB_ENABLED=true

# ---- Lark notify (optional — gửi digest tin tức sau mỗi lần crawl) --------
# Tạo Custom Bot trong group Lark → lấy webhook URL + signature secret
# LARK_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/xxx
# LARK_WEBHOOK_SECRET=

# ---- DNS fallback (DoH qua Google 8.8.8.8) — chống ISP chặn DNS ------------
# Domain bị ISP DNS chặn (VNPT hay chặn cụm Steam) sẽ tự resolve qua DoH.
# Google DoH trả edge CDN đúng vùng (honor EDNS Client Subnet) — đã verify.
# DNS_FALLBACK_HOSTS=api.steampowered.com,store.steampowered.com,steamcommunity.com
